---
import About from './About.astro';
import Contact from './Contact.astro';
import Experience from './Experience.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Projects from './Projects.astro';
---

<div class="min-h-screen overflow-hidden bg-slate-950 text-slate-100 selection:bg-amber-300 selection:text-slate-950">
	<div class="pointer-events-none fixed inset-0 -z-0 bg-gradient-to-b from-amber-950/20 to-transparent"></div>
	<div class="relative z-10">
		<Header />
		<main class="mx-auto max-w-5xl px-6">
			<Hero />
			<Experience />
			<Projects />
			<About />
			<Contact />
		</main>
		<footer class="border-t border-white/10 px-6 py-8 text-center text-sm text-slate-500">
			<p>&copy; <span id="year">2026</span> Mateo López. Todos los derechos reservados.</p>
		</footer>
	</div>
</div>
