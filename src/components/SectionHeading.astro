---
interface Props {
	title: string;
	number: string;
}

const { title, number } = Astro.props;
---

<div class="mb-10 flex items-center gap-4">
	<span class="font-mono text-sm text-amber-300">{number}</span>
	<h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">{title}</h2>
	<div class="h-px flex-1 bg-gradient-to-r from-white/20 to-transparent"></div>
</div>
